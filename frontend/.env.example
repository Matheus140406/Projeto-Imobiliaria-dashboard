VITE_API_URL=http://localhost:3000/api
# Mesmo valor de API_KEY que está no .env da raiz do backend. Fica embutida no
# bundle do frontend (não aparece na tela de login) — troque pelo valor real
# do seu ambiente, nunca reaproveite este placeholder.
VITE_API_KEY=replace-with-the-same-api-key-as-the-backend-env
