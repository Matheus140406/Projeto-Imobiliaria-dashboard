# Postgres (dev local via docker: `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres`,
# ou use um branch de dev grátis no Neon/Supabase). Em produção (Vercel), aponte para o
# Postgres do Neon/Supabase/Vercel Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/imobiliaria"
PORT=3000
NODE_ENV=development
# Gere com: openssl rand -hex 32 (nunca reaproveite o mesmo valor em produção)
API_KEY=replace-with-a-random-64-char-hex-string
JWT_SECRET=replace-with-another-random-64-char-hex-string
# Origens autorizadas a chamar a API via navegador, separadas por vírgula
CORS_ORIGIN=http://localhost:5173
# Só necessário em produção: protege o endpoint /cron/marcar-atrasadas chamado pelo Vercel Cron
# (a Vercel envia "Authorization: Bearer <CRON_SECRET>" sozinha quando essa env existe no projeto)
# CRON_SECRET=replace-with-another-random-32-char-hex-string

# Opcional: envio real de cobrança por email (se ausente, a ação fica registrada
# só no log de atividade, sem enviar de verdade).
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=usuario@exemplo.com
# SMTP_PASS=senha
# SMTP_FROM="Imobiliária <usuario@exemplo.com>"
