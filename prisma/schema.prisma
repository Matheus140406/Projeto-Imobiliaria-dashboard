generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite não suporta enums nativos: status são strings restritas em código
// (ver src/lib/status.ts) para StatusFatura e StatusContrato.

model Inquilino {
  id        String     @id @default(cuid())
  nome      String
  email     String?
  telefone  String?
  scoring   Int        @default(0)
  contratos Contrato[]
  createdAt DateTime   @default(now())
}

model Contrato {
  id                String         @id @default(cuid())
  inquilino         Inquilino      @relation(fields: [inquilinoId], references: [id])
  inquilinoId       String
  imovel            String
  valorAluguel       Float
  diaVencimento     Int
  percentualMulta   Float          @default(2)
  taxaJurosDiaria   Float          @default(0.033)
  dataInicio        DateTime
  dataFim           DateTime
  status            String         @default("ATIVO")
  faturas           Fatura[]
  createdAt          DateTime       @default(now())
}

model Fatura {
  id              String        @id @default(cuid())
  contrato        Contrato      @relation(fields: [contratoId], references: [id])
  contratoId      String
  competencia     String
  valorOriginal   Float
  valorMulta      Float         @default(0)
  valorJuros      Float         @default(0)
  valorTotal      Float
  dataVencimento  DateTime
  status          String        @default("PENDENTE")
  pagamentos      Pagamento[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([contratoId, competencia])
  @@index([status])
  @@index([dataVencimento])
}

model Pagamento {
  id             String   @id @default(cuid())
  fatura         Fatura   @relation(fields: [faturaId], references: [id])
  faturaId       String
  valorPago      Float
  dataPagamento  DateTime @default(now())
  metodo         String
  registradoPor  String
  observacao     String?
  createdAt      DateTime @default(now())
}

model AuditoriaPagamento {
  id         String   @id @default(cuid())
  faturaId   String
  acao       String
  detalhes   String
  usuario    String
  createdAt  DateTime @default(now())
}
